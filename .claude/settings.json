{
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm verify:core)",
      "Bash(pnpm test:e2e*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(rm *)",
      "Edit(LICENSE)",
      "Edit(LICENSES.md)",
      "Edit(docs/adr/005-licensing.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/block-roms.mjs" }]
      }
    ]
  }
}
