  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "prettier": "3.6.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
