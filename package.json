{
  "name": "cartivo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1",
    "build": "vite build apps/web",
    "check": "svelte-check --workspace apps/web --tsconfig ../../tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "prettier --check \"packages/*/src/*.ts\" \"tests/*.ts\"",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "preview": "vite preview apps/web --host 127.0.0.1 --port 4173",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts --project=chromium",
    "test:e2e:preview:firefox": "playwright test --config playwright.preview.config.ts --project=firefox",
    "test:e2e:preview:webkit": "playwright test --config playwright.preview.config.ts --project=webkit",
    "verify:core": "node tools/verify-jsnes.mjs && node tools/verify-tetanes.mjs && node tools/verify-core.mjs sameboy mgba snes9x genesis-plus-gx pcsx-rearmed mupen64plus-next",
    "context": "node tools/context.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "prettier": "3.6.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "bits-ui": "2.20.6",
    "jsnes": "2.1.0"
  }
}
